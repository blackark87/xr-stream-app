<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.HEAD_TRACKING" />
    <uses-permission android:name="android.permission.HAND_TRACKING" />
    <uses-permission android:name="android.permission.EYE_TRACKING" />
    <uses-permission android:name="android.permission.SCENE_UNDERSTANDING" />
    <!-- Optional for Jetpack XR SDK - allows testing on non-XR devices -->
    <uses-feature
        android:name="android.software.xr.api.spatial"
        android:required="false" />
    <!-- Sets android:required to true, indicating that your app can't function on devices without controllers. -->
    <uses-feature
        android:name="android.hardware.xr.input.controller"
        android:required="false" />
    <!-- Sets android:required to true, indicating that your app can't function on devices without hand tracking. -->
    <uses-feature
        android:name="android.hardware.xr.input.hand_tracking"
        android:required="false" />
    <!-- Sets android:required to true, indicating that your app can't function on devices without eye tracking. -->
    <uses-feature
        android:name="android.hardware.xr.input.eye_tracking"
        android:required="false" />
    <!-- Sets android:required to true, indicating that your app can't function on devices without head tracking. -->
    <uses-feature
        android:name="android.hardware.xr.input.head_tracking"
        android:required="false" />
    <uses-feature
        android:name="android.software.xr.api.openxr"
        android:required="true"
        android:version="0x00010001" />

    <application
        android:name=".XRStreamApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XRStream"
        android:usesCleartextTraffic="false">

        <uses-native-library
            android:name="libopenxr.google.so"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.XRStream">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- XR Activity Start Mode -->
            <property
                android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
                android:value="XR_ACTIVITY_START_MODE_FULL_SPACE_MANAGED" />

            <!-- Enable OpenXR Extensions -->
            <property
                android:name="android.software.xr.openxr.extensions"
                android:value="XR_EXT_dpad_binding" />
        </activity>

        <receiver
            android:name=".remote.AppUpdateStatusReceiver"
            android:exported="false" />
    </application>

</manifest>
