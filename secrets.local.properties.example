# Copy this file to secrets.local.properties. The destination is ignored by Git.
# Fine-grained PAT scope: this repository, Contents: read only.
INTERNAL_GITHUB_PAT=

# DMM application credentials issued for this app. Do not commit real values.
DMM_CLIENT_ID=
DMM_CLIENT_SECRET=
DMM_REDIRECT_URI=
DMM_JWT_SECRET=
# Optional override for the browser landing page.
DMM_LIBRARY_URL=https://www.dmm.co.jp/digital/videoa/-/mylibrary/

# DMM Digital API values issued/authorized for this app. The auth secret signs
# playable-provider requests; never copy it from another APK or commit it.
DMM_DIGITAL_API_BASE_URL=https://vr.digapi.dmm.com
DMM_DIGITAL_API_AUTH_SECRET=
DMM_EXPLOIT_ID_PREFIX=uid:
DMM_APP_NAME=android_vr_store
DMM_API_APP_VERSION=
# One of the qualities accepted for content on the account, such as high/uhq/lite.
DMM_DEFAULT_DOWNLOAD_QUALITY=high
